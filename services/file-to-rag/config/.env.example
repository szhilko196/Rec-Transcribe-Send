# OpenWebUI connection (required)
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=your-api-key-here

# Knowledge Base name (appears as #MyFiles in OpenWebUI)
FILETORAG_KB_NAME=MyFiles

# Watch folder (relative to project root)
FILETORAG_WATCH_FOLDER=data/FileToRag

# Chunk settings
FILETORAG_CHUNK_BY_HEADERS=true
FILETORAG_CHUNK_SIZE_LINES=150

# Parallel upload settings (higher = faster but more GPU/API load)
FILETORAG_PARALLEL_UPLOADS=4

# Log level
FILETORAG_LOG_LEVEL=INFO
