# RAGFlow Configuration
# Copy this file to .env and fill in your values

# Claude API Key (required for LLM generation and contextual enrichment)
CLAUDE_API_KEY=sk-ant-api03-xxxxx

# RAGFlow API Key (generate this from RAGFlow UI after first startup)
# Settings → API Keys → Create New Key
RAGFLOW_API_KEY=

# Optional: Change to 'cuda' if you have GPU available
EMBEDDING_DEVICE=cpu
