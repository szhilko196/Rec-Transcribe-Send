# ============================================================
# REQUIRED SETTINGS
# ============================================================

# Claude API Key for generating summary and protocol
# Get it at: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-xxxxx

# HuggingFace Token for pyannote.audio (speaker diarization)
# Get it at: https://huggingface.co/settings/tokens
# Accept license: https://huggingface.co/pyannote/speaker-diarization
HF_TOKEN=hf_xxxxx

# ============================================================
# WHISPER - Transcription Settings
# ============================================================

# Whisper model (affects quality and speed)
# Options: tiny, base, small, medium, large-v2
# Recommended: medium (balance of quality and speed)
WHISPER_MODEL=medium

# Device for processing
# Options: cpu, cuda (requires GPU + WSL2)
DEVICE=cpu

# Transcription language
# Options: ru, en, etc.
LANGUAGE=ru

# ============================================================
# SPEAKER RECOGNITION (Optional)
# ============================================================

# Enable/disable speaker recognition feature
# When enabled, the system will identify known speakers by voice
# and replace generic labels (SPEAKER_00) with real names
# Default: false
ENABLE_SPEAKER_RECOGNITION=false

# Confidence threshold for speaker identification (0.0-1.0)
# Higher = more strict (fewer false positives, more unrecognized)
# Lower = more lenient (more recognitions, possible false positives)
# Recommended: 0.75 (balanced)
# Options: 0.65 (lenient), 0.75 (balanced), 0.85 (strict)
RECOGNITION_THRESHOLD=0.75

# Device for speaker recognition (independent from transcription device)
# Options: cpu, cuda (requires GPU + CUDA support)
# If not set, falls back to DEVICE variable
# Using GPU can speed up recognition by 3-4x
SPEAKER_RECOGNITION_DEVICE=cpu

# Path to speaker profiles directory
# Contains speakers.json and audio samples for enrollment
# Default: ./data/speaker_profiles
SPEAKER_PROFILES_PATH=./data/speaker_profiles

# ============================================================
# DIARIZATION CONFIGURATION
# ============================================================

# Diarization architecture type
# true = NEW architecture (diarization on full file, no speaker duplicates)
#        Pro: Consistent speaker labels across entire meeting
#        Con: Very slow for long files (especially on CPU)
# false = OLD architecture (diarization in chunks, possible speaker duplicates)
#         Pro: Faster processing (especially for long files)
#         Con: Speaker labels may be inconsistent between chunks
#         (SPEAKER_00 in chunk 1 may be different person than SPEAKER_00 in chunk 2)
# Default: true (recommended if using GPU or processing short files <30 min)
USE_NEW_DIARIZATION_ARCHITECTURE=true

# Chunk duration for audio processing (in seconds)
# Audio files longer than this will be split into chunks for transcription
# Smaller chunks = faster parallel processing but more speaker duplicates (OLD architecture)
# Larger chunks = slower processing but fewer speaker duplicates
# Examples:
#   600 = 10 minutes (faster, more duplicates)
#   900 = 15 minutes
#   1800 = 30 minutes (balanced, default)
#   3600 = 60 minutes (slower, fewer duplicates)
# Default: 1800 (30 minutes)
CHUNK_DURATION_SEC=1800

# Diarization speaker detection settings (optional)
# Leave commented for automatic detection

# Exact number of speakers (if known in advance)
# Uncomment and set if you always have the same number of speakers
# DIARIZATION_NUM_SPEAKERS=3

# Minimum number of speakers (for auto-detection)
# Default: 1
DIARIZATION_MIN_SPEAKERS=1

# Maximum number of speakers (for auto-detection)
# Helps avoid over-segmentation (one speaker split into multiple)
# Default: 10
DIARIZATION_MAX_SPEAKERS=10

# ============================================================
# OPTIONAL SETTINGS
# ============================================================

# PostgreSQL password (used if postgres is uncommented in docker-compose.yml)
POSTGRES_PASSWORD=your_secure_password

# Context7 MCP Token (for library documentation integration)
CONTEXT7MCP=ctx7sk-xxxxx

# Path to data folder (optional, defaults to ./data)
# ⚠️ Use FORWARD SLASHES (/), not backslashes (\)
# Examples:
#   DATA_PATH=./data
#   DATA_PATH=C:/Users/YourName/YandexDisk/VideoPars/data
DATA_PATH=./data

# ============================================================
# SMTP - Email Results Delivery (Optional)
# ============================================================

# SMTP server (e.g., smtp.gmail.com, smtp.mail.ru, smtp.yandex.ru)
SMTP_SERVER=smtp.example.com

# SMTP port (usually 587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# Use TLS encryption (true/false)
SMTP_USE_TLS=true

# SMTP login (usually your email)
SMTP_USERNAME=your-email@example.com

# SMTP password
# ⚠️ For Gmail use "App Password", not your main password!
# Create at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-password

# Sender email (may differ from SMTP_USERNAME)
SMTP_FROM_EMAIL=noreply@example.com

# Sender name
SMTP_FROM_NAME=Meeting Transcriber

# ============================================================
# RAGFlow RAG SYSTEM (Semantic Search)
# ============================================================

# Enable automatic RAGFlow upload after transcription completes
# When enabled, meetings will be automatically indexed in RAGFlow for semantic search
# You can then query meetings via natural language through RAGFlow UI or API
# Default: false
ENABLE_RAG_INDEXING=false

# RAGFlow service URL (default port: 9380)
# Change if RAGFlow runs on different host/port
RAGFLOW_URL=http://localhost:9380

# RAGFlow API Key
# Generate this from RAGFlow UI after first startup:
# 1. Start RAGFlow: cd services/RAG-search && docker-compose -f docker-compose.ragflow.yml up -d
# 2. Open http://localhost:9380 (login: admin/admin)
# 3. Go to Settings → API Keys
# 4. Click "Create New Key"
# 5. Copy the key and paste here
RAGFLOW_API_KEY=

# Contextual Retrieval (Anthropic technique)
# When enabled, adds meeting context to each chunk before embedding
# This significantly improves retrieval accuracy (+30% per Anthropic benchmarks)
# Uses Claude API to generate context for each chunk
# Default: true
ENABLE_CONTEXTUAL_RETRIEVAL=true

# Model for context generation (uses same CLAUDE_API_KEY from above)
# Default: claude-sonnet-4-5-20250929
CONTEXT_GENERATION_MODEL=claude-sonnet-4-5-20250929

# Note: RAGFlow embedding model (BGE-M3), vector engine (Infinity),
# reranker (bge-reranker-v2-m3), and LLM (Claude Sonnet 4.5) are
# configured via RAGFlow UI, not environment variables
