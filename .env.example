# ============================================================
# REQUIRED SETTINGS
# ============================================================

# Claude API Key for generating summary and protocol
# Get it at: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-xxxxx

# HuggingFace Token for pyannote.audio (speaker diarization)
# Get it at: https://huggingface.co/settings/tokens
# Accept license: https://huggingface.co/pyannote/speaker-diarization
HF_TOKEN=hf_xxxxx

# ============================================================
# WHISPER - Transcription Settings
# ============================================================

# Whisper model (affects quality and speed)
# Options: tiny, base, small, medium, large-v2
# Recommended: medium (balance of quality and speed)
WHISPER_MODEL=medium

# Device for processing
# Options: cpu, cuda (requires GPU + WSL2)
DEVICE=cpu

# Transcription language
# Options: ru, en, etc.
LANGUAGE=ru

# ============================================================
# SPEAKER RECOGNITION (Optional)
# ============================================================

# Enable/disable speaker recognition feature
# When enabled, the system will identify known speakers by voice
# and replace generic labels (SPEAKER_00) with real names
# Default: false
ENABLE_SPEAKER_RECOGNITION=false

# Confidence threshold for speaker identification (0.0-1.0)
# Higher = more strict (fewer false positives, more unrecognized)
# Lower = more lenient (more recognitions, possible false positives)
# Recommended: 0.75 (balanced)
# Options: 0.65 (lenient), 0.75 (balanced), 0.85 (strict)
RECOGNITION_THRESHOLD=0.75

# Device for speaker recognition (independent from transcription device)
# Options: cpu, cuda (requires GPU + CUDA support)
# If not set, falls back to DEVICE variable
# Using GPU can speed up recognition by 3-4x
SPEAKER_RECOGNITION_DEVICE=cpu

# Path to speaker profiles directory
# Contains speakers.json and audio samples for enrollment
# Default: ./data/speaker_profiles
SPEAKER_PROFILES_PATH=./data/speaker_profiles

# ============================================================
# OPTIONAL SETTINGS
# ============================================================

# PostgreSQL password (used if postgres is uncommented in docker-compose.yml)
POSTGRES_PASSWORD=your_secure_password

# Context7 MCP Token (for library documentation integration)
CONTEXT7MCP=ctx7sk-xxxxx

# Path to data folder (optional, defaults to ./data)
# ⚠️ Use FORWARD SLASHES (/), not backslashes (\)
# Examples:
#   DATA_PATH=./data
#   DATA_PATH=C:/Users/YourName/YandexDisk/VideoPars/data
DATA_PATH=./data

# ============================================================
# SMTP - Email Results Delivery (Optional)
# ============================================================

# SMTP server (e.g., smtp.gmail.com, smtp.mail.ru, smtp.yandex.ru)
SMTP_SERVER=smtp.example.com

# SMTP port (usually 587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# Use TLS encryption (true/false)
SMTP_USE_TLS=true

# SMTP login (usually your email)
SMTP_USERNAME=your-email@example.com

# SMTP password
# ⚠️ For Gmail use "App Password", not your main password!
# Create at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-password

# Sender email (may differ from SMTP_USERNAME)
SMTP_FROM_EMAIL=noreply@example.com

# Sender name
SMTP_FROM_NAME=Meeting Transcriber
